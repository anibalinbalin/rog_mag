# ---------------------------------------------------------------------------
# Self-hosted TinaCMS (no TinaCloud).
# Local dev needs NONE of these — the "dev" script sets TINA_PUBLIC_IS_LOCAL=true,
# which uses an in-memory database and disables auth. The vars below are only
# required in production (Vercel).
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string — the content index. Shared cluster "tina-cms";
# this project uses dbName "olivera_mag" (set in tina/database.ts).
MONGODB_URI=

# GitHub — commits content edits back to the repo.
# PAT (or gh oauth token) with contents read/write on anibalinbalin/rog_mag.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Optional — Vercel auto-fills owner/repo/branch from the git connection.
GITHUB_OWNER=anibalinbalin
GITHUB_REPO=rog_mag
GITHUB_BRANCH=main

# Clerk auth (Google sign-in). The TINA_PUBLIC_ prefix exposes the publishable
# key to the admin UI bundle; the secret key stays server-side.
TINA_PUBLIC_CLERK_PUBLIC_KEY=pk_test_xxx
CLERK_SECRET=sk_test_xxx

# Comma-separated emails allowed into /admin (matched against the Clerk
# user's primary email).
TINA_PUBLIC_ALLOWED_EMAILS=rolivera@olivera.com.uy,admin@olivera.com.uy,rddcydle@gmail.com
